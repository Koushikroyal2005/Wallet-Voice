APP_ENV=development
DEMO_MODE=true
DATABASE_URL=postgresql+psycopg://aiwallet:aiwallet@db:5432/aiwallet
WEB_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080
DEFAULT_CURRENCY=INR
DEFAULT_DAILY_SPENDING_LIMIT=1000000
DEFAULT_PER_TRANSACTION_LIMIT=500000
DEFAULT_MINIMUM_BALANCE=10000
APP_TIMEZONE=Asia/Kolkata
DEMO_AUTH_MODE=true
NVIDIA_API_KEY=
NVIDIA_ENABLED=false
NVIDIA_NEMOTRON_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_NEMOTRON_MODEL_ID=nvidia/nemotron-3.5-bolt-e4b
NVIDIA_WHISPER_SERVER=grpc.nvcf.nvidia.com:443
NVIDIA_WHISPER_FUNCTION_ID=b702f636-f60c-4a3d-a6f4-f3568c13bd7d
NVIDIA_WHISPER_LANGUAGE_CODE=multi
NVIDIA_WHISPER_TASK=transcribe
NVIDIA_MAGPIE_SYNTHESIS_URL=https://877104f7-e885-42b9-8de8-f6e4c6303969.invocation.api.nvcf.nvidia.com/v1/audio/synthesize
NVIDIA_MAGPIE_LIST_VOICES_URL=https://877104f7-e885-42b9-8de8-f6e4c6303969.invocation.api.nvcf.nvidia.com/v1/audio/list_voices
NVIDIA_MAGPIE_VOICE=Magpie-Multilingual.EN-US.Aria
NVIDIA_WHISPER_TIMEOUT=45
NVIDIA_NEMOTRON_TEMPERATURE=0.2
NVIDIA_NEMOTRON_MAX_TOKENS=300
NVIDIA_NEMOTRON_TIMEOUT=30
NVIDIA_MAGPIE_LANGUAGE=en-US
NVIDIA_MAGPIE_ENCODING=LINEAR_PCM
NVIDIA_MAGPIE_SAMPLE_RATE=44100
VOICE_MAX_DURATION_SECONDS=60
VOICE_MAX_UPLOAD_MB=10
VOICE_DEFAULT_LANGUAGE=en-US
VOICE_HISTORY_MAX_TURNS=6
VOICE_BROWSER_TTS_FALLBACK=true
PAYPAL_MODE=sandbox
PAYPAL_ENABLED=false
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_CHECKOUT_CURRENCY=USD
PAYPAL_APPLICATION_CURRENCY=INR
PAYPAL_DEMO_INR_PER_USD=84
PAYPAL_HTTP_TIMEOUT_SECONDS=20
PAYPAL_OAUTH_REFRESH_BUFFER_SECONDS=120
DEMO_WALLET_PIN=123456
AUTHORIZATION_TTL_SECONDS=180
PIN_MAX_ATTEMPTS=5
PIN_LOCKOUT_MINUTES=5
DEMO_MERCHANT_NAME=Indian Railways
DEMO_MERCHANT_API_KEY=change-this-demo-merchant-key
REQUIRE_WALLET_LOGIN=true
# Required before startup with sign-in enabled. Generate locally using:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
# Paste the result into your PRIVATE .env only; never commit or share it.
WALLET_SESSION_SECRET=
WALLET_SESSION_MINUTES=30
# Set true when the entire frontend is served over HTTPS.
WALLET_COOKIE_SECURE=false
# Optional browser Web Push. Generate your own VAPID pair; never commit real keys.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
